# The /exec URL of the Apps Script web app that fronts the sheet. See the Setup section of README.md.
#
# This is PUBLIC: Vite inlines it into the shipped bundle, and it has to be,
# because a view-only visitor reads the board through it with no credential at
# all. Nothing in this app may depend on the URL being hard to guess.
VITE_SCRIPT_URL=

# DEV ONLY, and normally left unset. `src/lib/sheets.js` defaults to the real
# `https://sheets.googleapis.com/v4/spreadsheets`; setting this points it at
# `scripts/stub-endpoint.mjs` instead, through the proxy in `vite.config.js`, so
# `scripts/drive.mjs` can exercise the true write path without a deployment.
#
# NEVER set this in a build that ships. It is the one variable here that could
# send a bearer token somewhere it does not belong.
#
#   VITE_SCRIPT_URL=/wedding/__endpoint
#   VITE_SHEETS_BASE=/wedding/__sheets
